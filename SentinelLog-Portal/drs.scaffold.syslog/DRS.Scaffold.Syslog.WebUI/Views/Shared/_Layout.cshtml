<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DRS.Scaffold.Syslog.WebUI</title>
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/sentinel.css" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="homepage">
    @RenderBody()
    <script src="~/js/sentinel.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
