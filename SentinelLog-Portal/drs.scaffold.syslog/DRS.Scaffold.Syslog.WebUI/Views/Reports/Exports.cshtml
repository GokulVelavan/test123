@{
    Layout = "_AppLayout";
    ViewData["Title"] = "Reports — Export Jobs";
    ViewData["TopbarMeta"] = "Manage bulk log export jobs";
}
@await Html.PartialAsync("_ReportsNav")
<div style="padding:20px;display:flex;flex-direction:column;gap:16px">

    <div class="panel">
        <div class="panel-header">
            <div class="panel-title">Export Jobs</div>
            <div class="panel-controls">
                <button class="btn btn-accent btn-sm" onclick="openExportModal()">&#43; New Export</button>
            </div>
        </div>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Job ID</th>
                    <th>Format</th>
                    <th>Filters</th>
                    <th>Status</th>
                    <th>File</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="exportTbody">
                <tr><td colspan="7" style="color:var(--text-muted);text-align:center">Loading…</td></tr>
            </tbody>
        </table>
        <div id="exportPager" style="display:flex;gap:8px;padding:12px 16px;align-items:center;border-top:1px solid var(--border)"></div>
    </div>

</div>

@* ── New Export Modal ────────────────────────────────────────────────────────── *@
<div id="exportModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:1000;align-items:center;justify-content:center">
    <div style="background:var(--bg-panel);border:1px solid var(--border);border-radius:10px;padding:28px;width:480px">
        <div style="font-size:15px;font-weight:600;color:var(--text-primary);margin-bottom:20px">New Export Job</div>
        <div style="display:flex;flex-direction:column;gap:14px">
            <div>
                <label class="form-label">Format</label>
                <select class="form-control" id="expFormat">
                    <option value="CSV">CSV</option>
                    <option value="JSON">JSON</option>
                    <option value="SYSLOG">Syslog (RFC5424)</option>
                </select>
            </div>
            <div>
                <label class="form-label">Keyword / Message Filter</label>
                <input class="form-control" id="expKeyword" placeholder="Leave blank for all logs" />
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                <div>
                    <label class="form-label">Severity</label>
                    <select class="form-control" id="expSeverity">
                        <option value="">Any</option>
                        <option value="0">Emergency</option>
                        <option value="1">Alert</option>
                        <option value="2">Critical</option>
                        <option value="3">Error</option>
                        <option value="4">Warning</option>
                        <option value="5">Notice</option>
                        <option value="6">Info</option>
                        <option value="7">Debug</option>
                    </select>
                </div>
                <div>
                    <label class="form-label">Last N Days</label>
                    <select class="form-control" id="expDays">
                        <option value="1">Last 1 day</option>
                        <option value="7" selected>Last 7 days</option>
                        <option value="30">Last 30 days</option>
                        <option value="90">Last 90 days</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="form-label">Hostname Filter</label>
                <input class="form-control" id="expHostname" placeholder="e.g. fw-core-01" />
            </div>
        </div>
        <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:20px">
            <button class="btn btn-sm" onclick="closeExportModal()" style="background:var(--bg-elevated);color:var(--text-muted);border:1px solid var(--border)">Cancel</button>
            <button class="btn btn-accent btn-sm" onclick="createExport()">&#8615; Queue Export</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
function esc(s) { var d = document.createElement('div'); d.textContent = String(s ?? ''); return d.innerHTML; }
var _expPage = 1, _expPageSize = 25;

const STATUS_COLOR = { Queued: 'var(--text-muted)', Running: 'var(--sev-warning)', Completed: 'var(--sev-notice)', Failed: 'var(--sev-error)', Cancelled: 'var(--text-muted)' };

async function loadExports() {
    const tbody = document.getElementById('exportTbody');
    try {
        const r = await fetch(`/api/export-jobs?page=${_expPage}&pageSize=${_expPageSize}`);
        if (!r.ok) { tbody.innerHTML = `<tr><td colspan="7" style="color:var(--sev-error);text-align:center">Failed.</td></tr>`; return; }
        const d = await r.json();

        if (!d.items?.length) {
            tbody.innerHTML = `<tr><td colspan="7" style="color:var(--text-muted);text-align:center">No export jobs. Click "+ New Export" to queue one.</td></tr>`;
            renderExpPager(0); return;
        }

        tbody.innerHTML = d.items.map(j => {
            let filters = '—';
            try { const q = JSON.parse(j.queryDefinition || '{}'); filters = Object.entries(q).filter(([,v]) => v).map(([k,v]) => `${k}:${v}`).join(', ') || '—'; } catch {}
            return `<tr>
                <td class="mono" style="font-size:11px;color:var(--text-muted)">#${j.id}</td>
                <td><span class="sev-badge" style="background:var(--bg-elevated);color:var(--accent-cyan)">${esc(j.format)}</span></td>
                <td style="font-size:11px;color:var(--text-secondary);max-width:200px;overflow:hidden;text-overflow:ellipsis">${esc(filters)}</td>
                <td><span style="color:${STATUS_COLOR[j.status]||'var(--text-muted)'};font-weight:600;font-size:12px">${esc(j.status)}</span></td>
                <td style="font-size:11px;color:var(--text-muted)">${j.filePath ? esc(j.filePath.split('/').pop().split('\\').pop()) : '—'}</td>
                <td class="mono" style="font-size:11px;color:var(--text-muted)">${new Date(j.createdAt).toLocaleString()}</td>
                <td>
                    ${j.status === 'Completed' && j.filePath ? `<button class="btn btn-sm" style="font-size:11px;padding:3px 8px;background:transparent;border:1px solid var(--sev-notice);color:var(--sev-notice)" onclick="downloadExport(${j.id})">&#8615; Download</button>` : ''}
                    ${j.status !== 'Running' ? `<button class="btn btn-sm" style="font-size:11px;padding:3px 8px;background:transparent;border:1px solid var(--border);color:var(--sev-error);margin-left:4px" onclick="cancelExport(${j.id})">Delete</button>` : ''}
                </td>
            </tr>`;
        }).join('');
        renderExpPager(d.totalCount || 0);
    } catch { tbody.innerHTML = `<tr><td colspan="7" style="color:var(--sev-error);text-align:center">Network error.</td></tr>`; }
}

function renderExpPager(total) {
    const totalPages = Math.ceil(total / _expPageSize) || 1;
    document.getElementById('exportPager').innerHTML = `
        <span style="font-size:12px;color:var(--text-muted);flex:1">${total} jobs</span>
        <button class="btn btn-sm" style="font-size:11px" onclick="changeExpPage(${_expPage-1})" ${_expPage<=1?'disabled':''}>&#8249; Prev</button>
        <span style="font-size:12px;color:var(--text-muted)">Page ${_expPage} of ${totalPages}</span>
        <button class="btn btn-sm" style="font-size:11px" onclick="changeExpPage(${_expPage+1})" ${_expPage>=totalPages?'disabled':''}>Next &#8250;</button>`;
}

function changeExpPage(p) { _expPage = p; loadExports(); }

function openExportModal() {
    ['expKeyword','expHostname'].forEach(id => document.getElementById(id).value = '');
    document.getElementById('expFormat').value   = 'CSV';
    document.getElementById('expSeverity').value = '';
    document.getElementById('expDays').value     = '7';
    document.getElementById('exportModal').style.display = 'flex';
}

async function createExport() {
    const q = {};
    const kw = document.getElementById('expKeyword').value.trim();
    const sev = document.getElementById('expSeverity').value;
    const days = document.getElementById('expDays').value;
    const host = document.getElementById('expHostname').value.trim();
    if (kw)   q.keyword  = kw;
    if (sev)  q.severity = sev;
    if (days) q.days     = days;
    if (host) q.hostname = host;

    const body = {
        format:          document.getElementById('expFormat').value,
        queryDefinition: JSON.stringify(q)
    };

    try {
        const r = await fetch('/api/export-jobs', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        if (!r.ok) { alert('Failed to queue export.'); return; }
        closeExportModal();
        loadExports();
    } catch { alert('Network error.'); }
}

async function cancelExport(id) {
    if (!confirm(`Delete export job #${id}?`)) return;
    await fetch(`/api/export-jobs/${id}`, { method: 'DELETE' });
    loadExports();
}

async function downloadExport(id) {
    const r = await fetch('/api/export-jobs/' + id + '/download');
    if (!r.ok) { alert('Download failed (HTTP ' + r.status + ')'); return; }
    const blob = await r.blob();
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = 'export-' + id + '.csv';
    document.body.appendChild(a); a.click();
    document.body.removeChild(a); URL.revokeObjectURL(url);
}

function closeExportModal() { document.getElementById('exportModal').style.display = 'none'; }
document.getElementById('exportModal').addEventListener('click', function(e) { if (e.target === this) closeExportModal(); });

loadExports();
var _exportInterval = setInterval(loadExports, 15000); // Auto-refresh every 15s for running jobs
window.addEventListener('pagehide', function() { clearInterval(_exportInterval); });
</script>
}
