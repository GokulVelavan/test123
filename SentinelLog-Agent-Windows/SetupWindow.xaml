<Window x:Class="SyslogAgent.Desktop.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Syslog Machine Agent"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F4F6">

    <Grid>
        <Border Background="White" CornerRadius="12" Margin="30"
                BorderBrush="#E5E7EB" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.15"/>
            </Border.Effect>
            <StackPanel Margin="32,28">
                <!-- Header -->
                <TextBlock Text="Syslog Machine Agent" Style="{StaticResource HeaderText}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Configure your syslog server connection"
                           Style="{StaticResource SubHeaderText}"
                           HorizontalAlignment="Center" Margin="0,4,0,20"/>

                <Border Height="1" Background="#E5E7EB" Margin="0,0,0,8"/>

                <!-- IP/Hostname -->
                <TextBlock Text="Server IP / Hostname" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtHost" Text="127.0.0.1" Style="{StaticResource InputField}"/>

                <!-- Port -->
                <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtPort" Text="514" Style="{StaticResource InputField}"
                         MaxLength="5" PreviewTextInput="TxtPort_PreviewTextInput"/>

                <!-- Protocol -->
                <TextBlock Text="Protocol" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CmbProtocol" FontSize="14" Padding="10,8"
                          SelectedIndex="0">
                    <ComboBoxItem Content="UDP"/>
                    <ComboBoxItem Content="TCP"/>
                </ComboBox>

                <!-- Apply Filter -->
                <CheckBox x:Name="ChkFilter" Content="  Apply Event Filter (security events only)"
                          FontSize="13" Margin="0,18,0,0" Foreground="#333"/>

                <!-- Error message -->
                <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="12"
                           Margin="0,8,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <!-- Start button -->
                <Button Content="Start Monitoring" Style="{StaticResource PrimaryButton}"
                        Margin="0,24,0,0" Click="BtnStart_Click" x:Name="BtnStart"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
