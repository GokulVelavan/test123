<Window x:Class="SyslogAgent.Desktop.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Syslog Agent Dashboard"
        Width="1200" Height="720"
        MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="#1E293B" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,8,0"
                             x:Name="StatusDot"/>
                    <TextBlock Text="RUNNING" Foreground="#22C55E" FontWeight="SemiBold"
                               FontSize="12" VerticalAlignment="Center" x:Name="StatusText"/>
                </StackPanel>

                <!-- Connection info -->
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="24,0"
                           Foreground="#94A3B8" FontSize="13" x:Name="TxtConnection"/>

                <!-- Metrics -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0">
                    <TextBlock Text="Sent: " Foreground="#94A3B8" FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSent" Text="0" Foreground="#22C55E"
                               FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0">
                    <TextBlock Text="Errors: " Foreground="#94A3B8" FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtErrors" Text="0" Foreground="#F87171"
                               FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="16,0">
                    <TextBlock Text="Uptime: " Foreground="#94A3B8" FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtUptime" Text="00:00:00" Foreground="White"
                               FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Stop button -->
                <Button Grid.Column="5" Content="Stop" Style="{StaticResource StopButton}"
                        Margin="16,0,0,0" Click="BtnStop_Click" x:Name="BtnStop"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Filters -->
            <Border Grid.Column="0" Background="White" CornerRadius="8"
                    BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filter header -->
                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8,8,0,0"
                            Padding="14,10" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                        <TextBlock Text="Event Filters" FontWeight="SemiBold"
                                   FontSize="14" Foreground="#1E293B"/>
                    </Border>

                    <!-- Filter toggle + status -->
                    <Border Grid.Row="1" Padding="14,8" BorderBrush="#E5E7EB"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                             x:Name="FilterDot"/>
                                    <TextBlock x:Name="TxtFilterStatus" FontSize="12"
                                               Foreground="#64748B"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="BtnToggleFilter"
                                        Content="Turn ON" FontSize="11" FontWeight="SemiBold"
                                        Padding="10,4" Cursor="Hand"
                                        Click="BtnToggleFilter_Click"
                                        Background="#E0F2FE" Foreground="#0369A1"
                                        BorderBrush="#BAE6FD" BorderThickness="1">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#BAE6FD"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="TxtCollectorCount" FontSize="11"
                                       Foreground="#94A3B8" Margin="16,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Channel list -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  Padding="0,4">
                        <ItemsControl x:Name="ChannelList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Margin="4,2" IsExpanded="False">
                                        <Expander.Header>
                                            <TextBlock Text="{Binding Summary}"
                                                       FontSize="12" FontWeight="Medium"
                                                       Foreground="#334155"/>
                                        </Expander.Header>
                                        <ItemsControl ItemsSource="{Binding EventIds}"
                                                      Margin="20,2,4,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Display}"
                                                               FontSize="11"
                                                               Foreground="#64748B"
                                                               Margin="0,1"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Panel: Live Log Feed -->
            <Border Grid.Column="1" Background="White" CornerRadius="8"
                    BorderBrush="#E5E7EB" BorderThickness="1" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Log header -->
                    <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="8,8,0,0"
                            Padding="14,10" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="Live Log Feed" FontWeight="SemiBold"
                                       FontSize="14" Foreground="#1E293B"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <CheckBox x:Name="ChkAutoScroll" Content="Auto-scroll"
                                          IsChecked="True" FontSize="11" Foreground="#64748B"
                                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="Clear" FontSize="11" Padding="8,3"
                                        Background="#F1F5F9" BorderBrush="#E2E8F0"
                                        Click="BtnClear_Click" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Log DataGrid -->
                    <DataGrid Grid.Row="1" x:Name="LogGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              BorderThickness="0"
                              RowHeight="26"
                              FontSize="12"
                              CanUserReorderColumns="False"
                              SelectionMode="Single"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#FAFBFC">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TIME" Binding="{Binding Time}"
                                                Width="90" FontFamily="Consolas">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}"
                                                Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#1E293B"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="SEVERITY" Binding="{Binding Severity}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{Binding SeverityColor}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#475569"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#1E293B" Padding="16,8" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" FontSize="11" Foreground="#94A3B8"
                           VerticalAlignment="Center">
                    <Run Text="Collectors: "/>
                    <Run x:Name="TxtActiveCollectors" Text="0" Foreground="White"/>
                    <Run Text=" active"/>
                </TextBlock>

                <TextBlock Grid.Column="1" FontSize="11" Foreground="#94A3B8"
                           VerticalAlignment="Center" Margin="24,0">
                    <Run Text="Mode: "/>
                    <Run x:Name="TxtMode" Text="Realtime + Batch" Foreground="White"/>
                </TextBlock>

                <TextBlock Grid.Column="3" FontSize="11" Foreground="#64748B"
                           VerticalAlignment="Center">
                    <Run Text="Syslog Machine Agent v1.0.0"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
